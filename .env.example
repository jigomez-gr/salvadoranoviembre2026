# Puerto interno del contenedor
PORT=3000

# Carpeta COMPARTIDA de medios (la misma que usa la landing).
# En el servidor: /var/data/salvadora/media  (con subcarpetas videos/ flyers/ documentos/)
# En local (Windows): D:\tmp\antigraviti\salvadora\media_base
MEDIA_STORAGE_ROOT=/var/data/salvadora/media

# Solo para pruebas locales: carpeta extra con videos/ y flyers/ (los medios nuevos de esta minilanding)
# MEDIA_EXTRA_DIR=./media-nuevos

# Base de datos Postgres COMPARTIDA (misma que la landing/CRM). Opcional.
# DATABASE_URL=postgresql://USUARIO:CLAVE@HOST:5432/BASE
# MEDIA_TABLE="public"."media_assets"

# Web principal (enlace "Volver" y logotipo)
LANDING_URL=https://salvadoraconesa.es
